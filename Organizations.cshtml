@model ExpenseTrackerApp.ViewModels.OrganizationManagementViewModel
@{
    ViewData["Title"] = "Organization Management";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-building text-success"></i> Organization Management
        </h1>
        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <label for="searchTerm" class="form-label">Search</label>
                    <input type="text" class="form-control" id="searchTerm" name="searchTerm" 
                           value="@Model.SearchTerm" placeholder="Search by organization name...">
                </div>
                <div class="col-md-4">
                    <label for="filterStatus" class="form-label">Status</label>
                    <select class="form-select" id="filterStatus" name="filterStatus">
                        <option value="All" selected="@(Model.FilterStatus == "All")">All</option>
                        <option value="Active" selected="@(Model.FilterStatus == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.FilterStatus == "Inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Organizations Table -->
    <div class="card shadow">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-success">
                Organizations (@Model.Organizations.Count of total organizations)
            </h6>
        </div>
        <div class="card-body">
            @if (Model.Organizations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Organization</th>
                                <th>Owner</th>
                                <th>Created Date</th>
                                <th>Users Count</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var org in Model.Organizations)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="org-icon me-3">
                                                <i class="fas fa-building"></i>
                                            </div>
                                            <div>
                                                <strong>@org.Name</strong>
                                                @if (!string.IsNullOrEmpty(org.Description))
                                                {
                                                    <br><small class="text-muted">@org.Description</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <strong>@org.Owner.FirstName @org.Owner.LastName</strong>
                                            <br><small class="text-muted">@org.Owner.Email</small>
                                        </div>
                                    </td>
                                    <td>@org.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="badge bg-info">@org.Users.Count users</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-@(org.IsActive ? "success" : "danger")">
                                            @(org.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("OrganizationDetails", "Admin", new { id = org.Id })" 
                                               class="btn btn-info btn-sm" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <form method="post" action="@Url.Action("ToggleOrganizationStatus", "Admin")" 
                                                  class="d-inline" onsubmit="return confirm('Are you sure you want to @(org.IsActive ? "deactivate" : "activate") this organization?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="organizationId" value="@org.Id" />
                                                <button type="submit" class="btn btn-@(org.IsActive ? "warning" : "success") btn-sm" 
                                                        title="@(org.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="fas fa-@(org.IsActive ? "pause" : "play")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mt-3">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Organizations", new { page = Model.CurrentPage - 1, searchTerm = Model.SearchTerm, filterStatus = Model.FilterStatus })">Previous</a>
                                </li>
                            }
                            
                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Organizations", new { page = i, searchTerm = Model.SearchTerm, filterStatus = Model.FilterStatus })">@i</a>
                                </li>
                            }
                            
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Organizations", new { page = Model.CurrentPage + 1, searchTerm = Model.SearchTerm, filterStatus = Model.FilterStatus })">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-building fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No organizations found</h5>
                    <p class="text-muted">Try adjusting your search criteria.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
.org-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background-color: #28a745;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
}

.badge {
    font-size: 0.75rem;
}
</style>
